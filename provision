#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"
# shellcheck disable=SC1091
source "${ROOT}/scripts/dotenv.sh"
ENV_FILE="${PROVISION_ENV_FILE:-${ROOT}/.env}"

log() { printf '\n==> %s\n' "$1"; }
fail() { printf 'Provisioning error: %s\n' "$1" >&2; exit 1; }

compose() {
  docker compose --env-file "${ENV_FILE}" "$@"
}

load_required_env_value() {
  local key="$1" value
  value="$(dotenv_get "${key}" "${ENV_FILE}" || true)"
  [[ -n "${value}" ]] || fail "Missing required local configuration value: ${key}"
  printf -v "${key}" '%s' "${value}"
}

load_runtime_values() {
  local key
  for key in \
    APP_PORT \
    OLLAMA_MODEL \
    DEMO_USER_EMAIL \
    DEMO_USER_PASSWORD \
    GRAFANA_ADMIN_USER \
    GRAFANA_ADMIN_PASSWORD; do
    load_required_env_value "${key}"
  done
}

require_docker() {
  command -v docker >/dev/null 2>&1 || fail "Docker Engine and Docker Compose are required."
  docker info >/dev/null 2>&1 || fail "Docker is not running or this user cannot access it."
  docker compose version >/dev/null 2>&1 || fail "Docker Compose plugin is required."
}

create_env() {
  command -v openssl >/dev/null 2>&1 || fail "OpenSSL is required to generate local secrets."
  umask 077

  if [[ ! -f "${ENV_FILE}" ]]; then
    log "Generating local configuration"
    cp .env.example "${ENV_FILE}"
  else
    log "Keeping existing .env and filling missing local values"
  fi

  dotenv_set_if_missing MONGO_ROOT_PASSWORD "$(openssl rand -hex 32)" "${ENV_FILE}"
  dotenv_set_if_missing JWT_SECRET "$(openssl rand -hex 32)" "${ENV_FILE}"
  dotenv_set_if_missing MAIL_TOKEN_ENCRYPTION_KEY "$(openssl rand -hex 32)" "${ENV_FILE}"
  dotenv_set_if_missing DEMO_USER_PASSWORD "$(openssl rand -hex 12)" "${ENV_FILE}"
  dotenv_set_if_missing GRAFANA_ADMIN_PASSWORD "$(openssl rand -hex 16)" "${ENV_FILE}"

  local app_port redirect_uri default_redirect_uri
  app_port="$(dotenv_get APP_PORT "${ENV_FILE}")"
  redirect_uri="$(dotenv_get GOOGLE_REDIRECT_URI "${ENV_FILE}" || true)"
  default_redirect_uri="http://localhost:8080/api/v1/mail-accounts/google/callback"
  if [[ -z "${redirect_uri}" || "${redirect_uri}" == "${default_redirect_uri}" ]]; then
    dotenv_set_if_missing GOOGLE_REDIRECT_URI "http://localhost:${app_port}/api/v1/mail-accounts/google/callback" "${ENV_FILE}"
    if [[ "${redirect_uri}" == "${default_redirect_uri}" && "${app_port}" != 8080 ]]; then
      dotenv_set GOOGLE_REDIRECT_URI "http://localhost:${app_port}/api/v1/mail-accounts/google/callback" "${ENV_FILE}"
    fi
  fi
  chmod 0600 "${ENV_FILE}"
}

main() {
  require_docker
  create_env

  load_runtime_values

  log "Validating and building the local stack"
  compose config --quiet
  compose up -d --build --wait --wait-timeout 180

  log "Preparing the local Ollama model"
  if ! compose exec -T ollama ollama list |
    awk 'NR > 1 { print $1 }' |
    grep -Fxq "${OLLAMA_MODEL}"; then
    compose exec -T ollama ollama pull "${OLLAMA_MODEL}"
  fi

  log "Creating the local demo account and inbox"
  compose exec -T backend npm run seed:local

  compose ps

  cat <<EOF

SecureInbox is ready.

Application:  http://localhost:${APP_PORT}
Prometheus:   http://localhost:9090
Grafana:      http://localhost:3000

Demo account:
Email:        ${DEMO_USER_EMAIL}
Password:     ${DEMO_USER_PASSWORD}

Grafana:
User:         ${GRAFANA_ADMIN_USER}
Password:     ${GRAFANA_ADMIN_PASSWORD}
EOF
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
