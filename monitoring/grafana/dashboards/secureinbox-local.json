{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Backend availability",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "type": "stat",
      "targets": [{"expr": "up{job=\"secureinbox-backend\"}", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "API request rate",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "type": "timeseries",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"expr": "sum(rate(secureinbox_http_requests_total[5m]))", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "API 5xx ratio",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "type": "timeseries",
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {"expr": "sum(rate(secureinbox_http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(secureinbox_http_requests_total[5m])), 0.001)", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "title": "API latency p95",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "type": "timeseries",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(secureinbox_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "title": "Backend resident memory",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "type": "timeseries",
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"expr": "secureinbox_process_resident_memory_bytes", "refId": "A"}]
    },
    {
      "id": 6,
      "title": "Scheduled task outcomes (1h)",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "type": "timeseries",
      "targets": [
        {"expr": "sum by (task, result) (increase(secureinbox_scheduled_tasks_total[1h]))", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "title": "Last successful scheduled task",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "type": "stat",
      "fieldConfig": {"defaults": {"unit": "dateTimeAsLocal"}, "overrides": []},
      "targets": [
        {"expr": "max by (task) (secureinbox_scheduled_task_last_success_timestamp_seconds) * 1000", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "title": "Detection provider outcomes (1h)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "type": "timeseries",
      "targets": [
        {"expr": "sum by (provider, result) (increase(secureinbox_detection_provider_total[1h]))", "refId": "A"}
      ]
    }
  ],
  "schemaVersion": 41,
  "tags": ["secureinbox", "local"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "SecureInbox Local",
  "uid": "secureinbox-local",
  "version": 1
}
