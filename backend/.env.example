PORT=5500
NODE_ENV=development
DB_URI=mongodb://127.0.0.1:27017/secureinbox
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
MAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-key
FRONTEND_APP_URL=http://localhost:5173

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5500/api/v1/mail-accounts/google/callback

# Optional local Ollama semantic analysis
AI_SEMANTIC_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=30000
OLLAMA_PROMPT_VERSION=semantic-v1

# Optional notification and operational settings
ARCJET_KEY=
ARCJET_ENV=development
EMAIL_FROM=
EMAIL_PASSWORD=
SUPPORT_EMAIL=
SYNC_INTERVAL_MINUTES=15
