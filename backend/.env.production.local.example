# Copy to backend/.env.production.local and fill in real values.
# Never commit the real file — it is covered by .gitignore (.env.*.local).

PORT=5500
NODE_ENV=production

# MongoDB Atlas (M0 free tier) connection string
DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/secureinbox?retryWrites=true&w=majority

JWT_SECRET=
JWT_EXPIRES_IN=7d

# 32-byte key used to encrypt stored Gmail OAuth tokens
MAIL_TOKEN_ENCRYPTION_KEY=

# Google OAuth (Gmail) — redirect URI must match the value configured
# in Google Cloud Console exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/mail-accounts/google/callback

# Public URL of the frontend (also used for CORS)
FRONTEND_APP_URL=https://yourdomain.com

# Arcjet bot/rate-limit protection (optional — leave blank to disable)
ARCJET_KEY=
ARCJET_ENV=production

# Outgoing email (digest, contact form, alerts)
EMAIL_FROM=
EMAIL_PASSWORD=
SUPPORT_EMAIL=

# Ollama is disabled on the Raspberry Pi production deployment.
AI_SEMANTIC_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=45000
OLLAMA_PROMPT_VERSION=

# Auto-sync interval (minutes)
SYNC_INTERVAL_MINUTES=15

# Bootstrap admin (used by scripts/bootstrap-admin.js, optional)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
