# Copy to backend/.env.production.local and fill in real values.
# This file is read only by docker-compose.prod.yml; never commit the real file.

PORT=5500
NODE_ENV=production
DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/secureinbox?retryWrites=true&w=majority

JWT_SECRET=
JWT_EXPIRES_IN=7d
MAIL_TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/mail-accounts/google/callback
FRONTEND_APP_URL=https://yourdomain.com
EMAIL_AUTH_RAW_FETCH_TIMEOUT_MS=10000
EMAIL_AUTH_VERIFY_TIMEOUT_MS=5000
EMAIL_AUTH_MAX_RAW_BYTES=33554432
EMAIL_AUTH_MAX_CONCURRENCY=2
GMAIL_PUSH_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT_EMAIL=
GMAIL_POLL_INTERVAL_WITH_PUSH=60
THREAT_INTEL_ENABLED=false
WEB_RISK_API_KEY=
URLHAUS_AUTH_KEY=
THREAT_INTEL_MAX_URLS_PER_EMAIL=5
THREAT_INTEL_TIMEOUT_MS=10000

ARCJET_KEY=
ARCJET_ENV=production

EMAIL_FROM=
EMAIL_PASSWORD=
SUPPORT_EMAIL=

AI_SEMANTIC_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=300000
SCAN_CONCURRENCY=1
SYNC_INTERVAL_MINUTES=15
