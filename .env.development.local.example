PORT=5500
NODE_ENV=development
DB_URI=mongodb://127.0.0.1:27017/xai-licenta
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth for Gmail integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5500/api/v1/mail-accounts/google/callback

# Optional for admin bootstrap
ADMIN_NAME=Admin Licenta
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Optional extras kept outside MVP flow
# ARCJET_KEY=
# EMAIL_PASSWORD=
